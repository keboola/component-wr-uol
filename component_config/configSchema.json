{
  "type": "object",
  "title": "UOL Connection",
  "required": ["environment", "customer_id", "email", "#api_token"],
  "properties": {
    "environment": {
      "type": "string",
      "title": "Environment",
      "enum": ["sandbox", "production"],
      "default": "production",
      "propertyOrder": 1
    },
    "customer_id": {
      "type": "string",
      "title": "Customer ID",
      "description": "Your UOL customer ID (the subdomain of your UOL instance).",
      "propertyOrder": 2
    },
    "email": {
      "type": "string",
      "title": "API User Email",
      "propertyOrder": 3
    },
    "#api_token": {
      "type": "string",
      "title": "API Token",
      "format": "password",
      "propertyOrder": 4
    },
    "test_connection": {
      "type": "button",
      "format": "test-connection",
      "options": {"async": {"label": "Test Connection", "action": "testConnection"}},
      "propertyOrder": 5
    },
    "debug": {
      "type": "boolean",
      "title": "Debug",
      "default": false,
      "propertyOrder": 99
    }
  }
}
