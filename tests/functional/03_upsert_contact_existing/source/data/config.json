{
  "parameters": {
    "environment": "demo",
    "email": "PLACEHOLDER_EMAIL@example.com",
    "#api_token": "PLACEHOLDER_TOKEN",
    "endpoint": "contacts",
    "write_mode": "upsert",
    "column_mapping": [
      {
        "source": "name",
        "destination": "name"
      },
      {
        "source": "external_id",
        "destination": "external_id"
      }
    ],
    "write_results_table": true,
    "fail_on_error": false
  },
  "storage": {
    "input": {
      "tables": [
        {
          "source": "in.c-main.contacts",
          "destination": "contacts.csv"
        }
      ]
    }
  }
}